NODE_ENV=development
PORT=3011
# Secretos: genera cada uno con node -e "console.log(require('crypto').randomBytes(32).toString('hex'))".
# El servicio no arranca si falta alguno, es corto o es un valor de ejemplo.
DATABASE_URL=postgres://payment_svc:<DB_PASSWORD_PAYMENT>@localhost:5432/payment_db
JWT_SECRET=
ACCOUNT_SERVICE_URL=http://localhost:3002
LEDGER_SERVICE_URL=http://localhost:3006
AUTH_SERVICE_URL=http://localhost:3001
# Clave interna PROPIA de payment-service (la aceptan auth-service, account-service y ledger-service).
INTERNAL_API_KEY=
# Claves internas aceptadas (recargas de canjes de puntos): rewards:<clave-de-rewards>
INTERNAL_TRUSTED_KEYS=
